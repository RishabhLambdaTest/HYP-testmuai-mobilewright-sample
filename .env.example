# Copy to your shell env to run on testmuAI Cloud.

# testmuAI Cloud credentials (LT_USERNAME / LT_ACCESS_KEY are also accepted):
TESTMU_USERNAME=your_username
TESTMU_ACCESS_KEY=your_access_key

# The app under test — an lt://APP… id you uploaded once (see "Upload the app" in the README).
LT_APP_ANDROID=lt://APP_ANDROID_ID
LT_APP_IOS=lt://APP_IOS_ID
# or a single id for the active platform:
# TESTMU_APP=lt://APP_ID

PLATFORM=android

# Local run only (no cloud creds set) — path to a local app build for mobilecli:
# LOCAL_APP_ANDROID=./app.apk
# LOCAL_APP_IOS=./app.zip
